# Copy file này thành `.env` và điền giá trị theo môi trường của bạn
# cp .env.example .env

# Port của app (dùng ở server.js)
PORT=3052

# --- DEV (NODE_ENV=dev, mặc định) ---
DEV_APP_PORT=3052
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=27017
DEV_DB_NAME=dbDev

# --- PROD (NODE_ENV=prod) ---
PROD_APP_PORT=3000
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=27017
PROD_DB_NAME=dbProd
